{
  "redirects": [
    { "source": "/prompts", "destination": "/", "permanent": true },
    { "source": "/discover", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/guides", "destination": "/index.html" },
    { "source": "/guides/(.*)", "destination": "/index.html" },
    { "source": "/prompt/(.*)", "destination": "/index.html" },
    { "source": "/collections/(.*)", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
