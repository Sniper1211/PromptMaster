# ============================================================
# PentaPrompt 环境变量模板
# 用法：复制为 .env 后填写真实值（.env 已被 gitignore，永不提交）。
# 生产/预览环境请在 Vercel Dashboard → Settings → Environment Variables 配置，
# 不要依赖仓库里的任何文件。
#
# 安全规则：
#   1. 任何密钥 / 数据库连接串 / 口令都不得使用 VITE_ 前缀
#      —— VITE_ 变量会被编译进前端 bundle，等于公开。
#   2. 前端只允许出现公开信息（如投稿 webhook 地址）。
# ============================================================

# ---- AI 服务（仅服务端） ----
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 单 IP 在 10 分钟内允许的 AI 请求数（可选，默认 20）
AI_RATE_LIMIT_MAX=20

# ---- 数据库（仅服务端，Neon/Postgres） ----
# 建议使用最小权限角色（SELECT/INSERT/UPDATE/DELETE），不要用 owner 角色
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# ---- 管理后台（仅服务端） ----
# 用于 POST/PUT /api/prompts 等管理接口；请使用随机强口令
ADMIN_PASSWORD=

# ---- Cloudflare R2 图片存储（仅服务端；未启用可留空） ----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---- 前端公开变量（可为空；禁止放密钥） ----
VITE_SUBMISSION_WEBHOOK_URL=
